# Copy to .env and fill in. With DEMO_MODE=true the app runs fully offline.

# ============================================================================
# REQUIRED — model access
# ============================================================================
# NVIDIA NIM (build.nvidia.com, OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
CODEGEN_MODEL=z-ai/glm-5.1
ARCHITECT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# Set true to run fully offline (canned responses); false to call NIM.
DEMO_MODE=false
# Disable TLS verification for NIM (dev-only, for SSL-intercepting networks).
NVIDIA_INSECURE_SSL=true

# NeMo Agent Toolkit server (nat serve). When set, the Architect routes through
# NAT instead of calling NIM directly. Leave blank to call NIM directly.
NAT_URL=http://127.0.0.1:8001/generate

CORS_ORIGINS=*

# ============================================================================
# DEPLOY MODE — how generated apps are brought live
# ============================================================================
# "docker" runs a real Docker Compose stack (db + backend + frontend) as the
# live preview. Requires Docker Desktop running. Falls back to local processes.
DEPLOY_MODE=docker

# ============================================================================
# OPTIONAL — real cloud deploys + cloud self-healing.
# Leave ALL of these blank to test with the local Docker preview (the watchdog,
# RCA and self-heal still run against the local stack). Fill them in only to
# deploy to / self-heal on the real platforms.
# ============================================================================

# --- Vercel (frontend). Also needs the `vercel` CLI installed on PATH for
#     real deploy + frontend self-heal (vercel deploy --prod). ---
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# Team scope (slug). REQUIRED for token deploys when your Vercel account is a
# team (CLI 54+ won't pick a default non-interactively). Find it via
# `vercel teams ls` or your Vercel dashboard URL (vercel.com/<scope>).
VERCEL_SCOPE=

# --- GitHub (source push for the FREE Render path). When GITHUB_TOKEN is set,
#     the Deployment agent creates a PUBLIC repo per generated app and pushes it
#     (real `git push`); Render then builds from that public repo. Needs the
#     `git` CLI on PATH + a PAT with `repo` scope (classic) or
#     contents+administration:write (fine-grained). ---
GITHUB_TOKEN=
GIT_AUTHOR_NAME=AI Foundry
GIT_AUTHOR_EMAIL=deploy@aifoundry.local
# Retries for the create+push (the Render deploy depends on it). A transient OS
# "too many open files" (Errno 24) — common on Windows behind an antivirus file
# filter — usually clears on a short backoff. Tip: add an AV exclusion for this
# project folder / git if it persists.
GITHUB_PUSH_RETRIES=3

# --- Render (backend). Two real paths:
#   1. FREE public deploy: set RENDER_API_KEY (Account Settings -> API Keys) AND
#      GITHUB_TOKEN above. The agent creates a real Render web service from the
#      pushed public repo via the API -> https://<svc>.onrender.com (free plan,
#      cold-starts after idle). No credit card required.
#   2. Deploy-hook: RENDER_DEPLOY_HOOK_URL re-triggers one pre-existing service. ---
RENDER_API_KEY=
RENDER_DEPLOY_HOOK_URL=
RENDER_REGION=oregon
RENDER_PLAN=free
RENDER_DB_PLAN=free

# --- Supabase (database). When SUPABASE_URL is set, the DB is provisioned on
#     Supabase (instead of Render Postgres) and the watchdog health-checks it. ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=

# ============================================================================
# OPTIONAL — continuous monitoring watchdog tunables
# (raise interval/threshold if you deploy on Render free tier, which cold-starts)
# ============================================================================
MONITOR_ENABLED=true
MONITOR_INTERVAL_S=20
MONITOR_FAIL_THRESHOLD=2
MONITOR_HEARTBEAT_EVERY=6
