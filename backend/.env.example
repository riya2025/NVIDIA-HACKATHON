# Copy to .env and fill in. With demo_mode=true the app runs fully offline.

# NVIDIA NIM (build.nvidia.com, OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# NeMo Agent Toolkit server (nat serve). When set, agent reasoning is routed
# through NAT instead of calling NIM directly. Leave blank to call NIM directly.
NAT_URL=http://127.0.0.1:8001/generate

# AWS (generated-app deploy target) - left blank in demo
AWS_REGION=ap-south-1
ECS_CLUSTER=ai-foundry
ECR_REPO=ai-foundry/apps

# Behaviour
DEMO_MODE=true
CORS_ORIGINS=*
